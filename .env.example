# Earthdata Login / CDSE — nunca commitear secretos
# (opcionales; el visor básico NO las requiere)
EARTHDATA_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# URLs sobrescribibles (Earthdata unificado 2026 / SH marzo 2026)
# ECOAVES_CMR_GRANULES=https://cmr.earthdata.nasa.gov/search/granules.umm_json
# ECOAVES_CDSE_STAC_SEARCH=https://stac.dataspace.copernicus.eu/v1/search
# ECOAVES_CDSE_OAUTH_TOKEN=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Visor web (server.py)
# ECOAVES_HOST=0.0.0.0
# ECOAVES_PORT=8000

# NASA FIRMS (opcional). Sin key se usa CSV público regional 24h.
# Solicitar en https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=